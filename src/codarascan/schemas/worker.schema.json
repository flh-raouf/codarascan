{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codarascan.dev/schemas/worker-1.json",
  "title": "CodaraScan framed worker envelope",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "id", "operation"],
      "properties": {
        "protocol": { "const": 1 },
        "id": { "type": ["string", "integer", "number", "null"] },
        "operation": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "id", "ok"],
      "properties": {
        "protocol": { "const": 1 },
        "id": { "type": ["string", "integer", "number", "null"] },
        "ok": { "type": "boolean" },
        "event": { "enum": ["page", "complete"] },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message", "context"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "context": { "type": "object" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "ok": { "const": true } },
            "required": ["ok"]
          },
          "then": {
            "required": ["result"],
            "not": { "required": ["error"] }
          },
          "else": {
            "required": ["error"],
            "not": { "required": ["result"] }
          }
        }
      ],
      "additionalProperties": false
    }
  ]
}
